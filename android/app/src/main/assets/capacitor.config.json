{
	"appId": "com.championchess.manager",
	"appName": "ChampionChess Manager",
	"webDir": "dist",
	"android": {
		"allowMixedContent": true,
		"captureInput": true,
		"webContentsDebuggingEnabled": false
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 2000,
			"launchAutoHide": true,
			"backgroundColor": "#1e3a8a",
			"androidSplashResourceName": "splash",
			"showSpinner": false
		}
	}
}
